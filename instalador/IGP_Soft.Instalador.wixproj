<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputName>IGP_Soft</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <Cultures>es-ES</Cultures>
    <SuppressIces>ICE61</SuppressIces>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <VersionCompleta Condition="'$(VersionCompleta)' == ''">$(Version)</VersionCompleta>
    <ProgramaDir Condition="'$(ProgramaDir)' == ''">$(MSBuildThisFileDirectory)..\dist\</ProgramaDir>
    <ProgramaCarpeta>$([MSBuild]::EnsureTrailingSlash('$(ProgramaDir)'))</ProgramaCarpeta>
    <DefineConstants>Version=$(Version);VersionCompleta=$(VersionCompleta);ProgramaDir=$(ProgramaCarpeta)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>

</Project>
